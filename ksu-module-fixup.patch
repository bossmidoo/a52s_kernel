diff --git a/drivers/kernelsu/ksud.c b/drivers/kernelsu/ksud.c
index e69357cf3..22a4b709c 100644
--- a/drivers/kernelsu/ksud.c
+++ b/drivers/kernelsu/ksud.c
@@ -1,6 +1,8 @@
 #include <linux/rcupdate.h>
 #include <linux/slab.h>
+#include <linux/gfp.h>
 #include <linux/task_work.h>
+#include <linux/sched/task.h>
 #include <asm/current.h>
 #include <linux/compat.h>
 #include <linux/cred.h>
@@ -50,6 +52,95 @@
 bool ksu_module_mounted __read_mostly = false;
 bool ksu_boot_completed __read_mostly = false;
 
+#define KSU_MODULE_FIXUP_SCRIPT_PATH "/data/adb/ksu_module_fixup.sh"
+
+/*
+ * Fallback for a confirmed-on-device failure mode: ksud's own
+ * post-fs-data handling (handle_updated_modules(), userspace Rust,
+ * not ours to patch - it ships prebuilt, installed by the Manager
+ * app) is supposed to promote /data/adb/modules_update/<id> into
+ * /data/adb/modules/<id> on a fresh module install/update. On this
+ * device/kernel combo that promotion has been reproducibly observed
+ * to silently stay stuck across many consecutive boots - even with
+ * the existing boot-completed "post-fs-data" safety-net retry above -
+ * while the *exact same* rm+mv sequence, run by hand over adb once
+ * the system is fully booted, succeeds immediately (verified live,
+ * exit code 0, normal file attributes, no SELinux denial: the "su"
+ * domain ksud/this script both run under is permissive + allow-all,
+ * see selinux/rules.c, so this isn't a policy issue). Since we can't
+ * fix ksud's own binary, this script repeats that same, manually-
+ * verified-safe sequence automatically at boot_completed, as a
+ * guaranteed last-resort fallback. It is a pure no-op whenever ksud's
+ * own promotion already succeeded (nothing left under modules_update
+ * to move), so it never fights with normal operation.
+ */
+static const char KSU_MODULE_FIXUP_SCRIPT[] =
+	"#!/system/bin/sh\n"
+	"# Auto-written by the kernel on every boot - do not edit by hand,\n"
+	"# changes will be overwritten. See ksud.c, KSU_MODULE_FIXUP_SCRIPT.\n"
+	"for d in /data/adb/modules_update/*/; do\n"
+	"    [ -d \"$d\" ] || continue\n"
+	"    id=$(basename \"$d\")\n"
+	"    dest=\"/data/adb/modules/$id\"\n"
+	"    disabled=0\n"
+	"    removed=0\n"
+	"    [ -f \"$dest/disable\" ] && disabled=1\n"
+	"    [ -f \"$dest/remove\" ] && removed=1\n"
+	"    rm -rf \"$dest\"\n"
+	"    mv \"$d\" \"$dest\"\n"
+	"    [ \"$disabled\" = \"1\" ] && touch \"$dest/disable\" 2>/dev/null\n"
+	"    [ \"$removed\" = \"1\" ] && touch \"$dest/remove\" 2>/dev/null\n"
+	"done\n";
+
+static void do_write_module_fixup_script(struct callback_head *_cb)
+{
+	loff_t off = 0;
+	ssize_t written;
+	struct file *fp;
+	const size_t len = sizeof(KSU_MODULE_FIXUP_SCRIPT) - 1;
+
+	fp = filp_open(KSU_MODULE_FIXUP_SCRIPT_PATH,
+			O_WRONLY | O_CREAT | O_TRUNC, 0755);
+	if (IS_ERR(fp)) {
+		pr_err("ksu_module_fixup: create script failed: %ld\n",
+			   PTR_ERR(fp));
+		kfree(_cb);
+		return;
+	}
+
+	written = kernel_write(fp, KSU_MODULE_FIXUP_SCRIPT, len, &off);
+	if (written != len) {
+		pr_err("ksu_module_fixup: write script failed: %ld\n",
+			   (long)written);
+	}
+
+	filp_close(fp, 0);
+	kfree(_cb);
+}
+
+static void ksu_schedule_write_module_fixup_script(void)
+{
+	struct task_struct *tsk;
+	struct callback_head *cb;
+
+	tsk = get_pid_task(find_vpid(1), PIDTYPE_PID);
+	if (!tsk) {
+		pr_err("ksu_module_fixup: find init task err\n");
+		return;
+	}
+
+	cb = kzalloc(sizeof(struct callback_head), GFP_KERNEL);
+	if (!cb) {
+		pr_err("ksu_module_fixup: alloc cb err\n");
+		goto put_task;
+	}
+	cb->func = do_write_module_fixup_script;
+	task_work_add(tsk, cb, TWA_RESUME);
+
+put_task:
+	put_task_struct(tsk);
+}
+
 static const char KERNEL_SU_RC[] =
 	"\n"
 
@@ -84,6 +175,11 @@ static const char KERNEL_SU_RC[] =
 	// chance that actually completes module install/removal/mounting.
 	"    exec u:r:" KERNEL_SU_DOMAIN ":s0 root -- " KSUD_PATH
 	" post-fs-data\n"
+	// Second, independent safety net: guaranteed module-update
+	// promotion fallback (see KSU_MODULE_FIXUP_SCRIPT above for the
+	// full story). Runs last, after ksud has had both its chances.
+	"    exec u:r:" KERNEL_SU_DOMAIN ":s0 root -- /system/bin/sh "
+	KSU_MODULE_FIXUP_SCRIPT_PATH "\n"
 	"\n"
 
 	"\n";
@@ -108,6 +204,10 @@ void on_post_fs_data(void)
 
 	ksu_load_allow_list();
 	ksu_observer_init();
+	// (Re)write the module-update fixup script every boot, so it's
+	// always in sync with this kernel build before boot_completed
+	// execs it (see KSU_MODULE_FIXUP_SCRIPT above).
+	ksu_schedule_write_module_fixup_script();
 	// sanity check, this may influence the performance
 	stop_input_hook();
 }
