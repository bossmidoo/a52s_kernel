+#define KSU_IOCTL_SUSFS_SET_CMDLINE_OR_BOOTCONFIG _IOC(_IOC_WRITE, 'S', 13, 0)
+#define KSU_IOCTL_SUSFS_ADD_OPEN_REDIRECT _IOC(_IOC_WRITE, 'S', 14, 0)
+#define KSU_IOCTL_SUSFS_SUS_SU _IOC(_IOC_WRITE, 'S', 15, 0)
