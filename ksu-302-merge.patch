+
+/* TWA_RESUME was added in kernel 5.7 */
+#if LINUX_VERSION_CODE < KERNEL_VERSION(5, 7, 0)
+#define TWA_RESUME true
+#endif
+
+/* strncpy_from_user_nofault was added in kernel 5.10, provide compat for 5.4 */
+#if LINUX_VERSION_CODE < KERNEL_VERSION(5, 10, 0)
+#define strncpy_from_user_nofault strncpy_from_user
+#endif
+
+/* copy_from/to_user_nofault were added in kernel 5.8, provide compat for 5.4 */
+#if LINUX_VERSION_CODE < KERNEL_VERSION(5, 8, 0)
+static inline long copy_from_user_nofault(void *dst, const void __user *src, size_t size)
+{
+	if (copy_from_user(dst, src, size))
+		return -EFAULT;
+	return 0;
+}
+static inline long copy_to_user_nofault(void __user *dst, const void *src, size_t size)
+{
+	if (copy_to_user(dst, src, size))
+		return -EFAULT;
+	return 0;
+}
+#endif
