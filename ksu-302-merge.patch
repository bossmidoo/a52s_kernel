+	kobject_del(&THIS_MODULE->mkobj.kobj);
+#endif
+#endif
+	return 0;
+}
+
+extern void ksu_observer_exit(void);
+void kernelsu_exit(void)
+{
+	ksu_allowlist_exit();
+
+	ksu_throne_tracker_exit();
+
+	ksu_observer_exit();
+
+	ksu_ksud_exit();
+
+	ksu_syscall_hook_manager_exit();
+
+	ksu_supercalls_exit();
+
+	ksu_avc_spoof_exit();
+
+	ksu_feature_exit();
+
+	if (ksu_cred) {
+		put_cred(ksu_cred);
+	}
+}
