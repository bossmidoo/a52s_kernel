+
+// Legacy IOCTL numbers for backward compatibility with v3.0.0 manager
+#define KSU_IOCTL_GET_HOOK_MODE_LEGACY _IOC(_IOC_READ, 'K', 19, 0)
+#define KSU_IOCTL_GET_VERSION_TAG_LEGACY _IOC(_IOC_READ, 'K', 20, 0)
+
+// SUSFS IOCTL commands
+#ifdef CONFIG_KSU_SUSFS
+#define KSU_IOCTL_SUSFS_ADD_SUS_PATH _IOC(_IOC_WRITE, 'S', 1, 0)
+#define KSU_IOCTL_SUSFS_ADD_SUS_PATH_LOOP _IOC(_IOC_WRITE, 'S', 2, 0)
