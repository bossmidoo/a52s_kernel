+	ksu_cred = prepare_creds();
+	if (!ksu_cred) {
+		pr_err("prepare cred failed!\n");
+	}
+
+	ksu_feature_init();
+
+	ksu_avc_spoof_init();
+
+	ksu_supercalls_init();
+
+	ksu_syscall_hook_manager_init();
+
+	ksu_allowlist_init();
+
+	ksu_throne_tracker_init();
+
+	ksu_ksud_init();
+
+	ksu_file_wrapper_init();
