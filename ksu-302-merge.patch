@@ -703,14 +725,26 @@ CONFIG_STACKPROTECTOR_STRONG=y
 CONFIG_ARCH_SUPPORTS_SHADOW_CALL_STACK=y
 CONFIG_SHADOW_CALL_STACK=y
 CONFIG_SHADOW_CALL_STACK_VMAP=y
-CONFIG_LTO=y
+# LTO disabled: scripts/Makefile.build's cmd_modversions_c (active
+# because CONFIG_MODVERSIONS=y + CONFIG_LTO_CLANG=y) runs
+# `$(LLVM_NM) $@ | grep -q __ksymtab` on every object file that
+# exports symbols. grep -q exits the instant it finds a match,
+# closing its end of the pipe while llvm-nm (11.1.0 here) may still
+# be writing - llvm-nm then aborts outright on the resulting SIGPIPE
+# ("LLVM ERROR: IO failure on output stream: Broken pipe") instead of
+# exiting quietly like GNU nm would. This is a known llvm-nm
+# brittleness under LTO+MODVERSIONS, unrelated to KernelSU; disabling
+# LTO removes this code path entirely. Pure build-config change, no
+# functional/root impact. CFI_CLANG is dropped too since it depends
+# on LTO_CLANG.
 CONFIG_ARCH_SUPPORTS_LTO_CLANG=y
 CONFIG_ARCH_SUPPORTS_THINLTO=y
-CONFIG_THINLTO=y
-# CONFIG_LTO_NONE is not set
-CONFIG_LTO_CLANG=y
-CONFIG_CFI_CLANG=y
-CONFIG_CFI_CLANG_SHADOW=y
+CONFIG_LTO_NONE=y
+# CONFIG_LTO is not set
+# CONFIG_THINLTO is not set
+# CONFIG_LTO_CLANG is not set
+# CONFIG_CFI_CLANG is not set
+# CONFIG_CFI_CLANG_SHADOW is not set
 # CONFIG_CFI_PERMISSIVE is not set
 CONFIG_HAVE_CONTEXT_TRACKING=y
 CONFIG_HAVE_VIRT_CPU_ACCOUNTING_GEN=y
